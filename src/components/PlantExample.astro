---
// Interactive example: one plant, one model, three questions.
// Behaviour lives in public/plant-example.js (CSP forbids inline scripts).
---
<section class="alt plant" aria-labelledby="plant-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">An example</p>
      <h2 id="plant-title">One plant, one model, three questions.</h2>
      <p class="lead">
        Alder Creek is a 612 MW combined-cycle power plant. What is known about it is spread across
        the maintenance plan, the manufacturer’s documentation, the process diagrams, the asset
        register and the financial model. ArborSpace brings them together in a single model that
        can be queried in any direction. Every answer is a path you can check.
      </p>
    </div>

    <div class="plant-tabs" role="group" aria-label="Choose a question">
      <button class="plant-tab" type="button" data-q="impact" aria-pressed="true">Impact</button>
      <button class="plant-tab" type="button" data-q="cause" aria-pressed="false">Root cause</button>
      <button class="plant-tab" type="button" data-q="precedent" aria-pressed="false">Precedents</button>
    </div>

    <div class="plant-grid">
      <div class="plant-graph">
        <svg viewBox="0 0 680 410" role="img" aria-labelledby="plant-svg-title">
          <title id="plant-svg-title">Graph of Alder Creek’s objects and their links</title>
          <defs>
            <marker id="plant-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </marker>
          </defs>
          <g marker-end="url(#plant-arrow)">
            <path class="e" id="plant-e1" d="M115 70 L115 118" />
            <path class="e" id="plant-e2" d="M190 145 L230 145 L230 45 L268 45" />
            <path class="e" id="plant-e3" d="M345 120 L345 72" />
            <path class="e" id="plant-e4" d="M500 45 L422 45" />
            <path class="e" id="plant-e5" d="M500 145 L422 145" />
            <path class="e" id="plant-e6" d="M115 170 L115 218" />
            <path class="e" id="plant-e7" d="M190 245 L268 245" />
            <path class="e" id="plant-e8" d="M345 170 L345 218" />
            <path class="e" id="plant-e9" d="M300 270 L300 318" />
            <path class="e" id="plant-e11" d="M320 345 L498 345" />
          </g>
          <g class="n" id="plant-nA"><rect x="40" y="20" width="150" height="50" rx="8" /><text class="t1" x="115" y="40" text-anchor="middle">Maintenance plan</text><text class="t2" x="115" y="58" text-anchor="middle">GT1 inspection, 2027</text></g>
          <g class="n" id="plant-nB"><rect x="270" y="20" width="150" height="50" rx="8" /><text class="t1" x="345" y="40" text-anchor="middle">AT-700F model</text><text class="t2" x="345" y="58" text-anchor="middle">Inspect every 15,000 h</text></g>
          <g class="n" id="plant-nC"><rect x="500" y="20" width="150" height="50" rx="8" /><text class="t1" x="575" y="40" text-anchor="middle">Plant B</text><text class="t2" x="575" y="58" text-anchor="middle">Comparable asset</text></g>
          <g class="n" id="plant-nD"><rect x="40" y="120" width="150" height="50" rx="8" /><text class="t1" x="115" y="140" text-anchor="middle">GT1</text><text class="t2" x="115" y="158" text-anchor="middle">Gas turbine</text></g>
          <g class="n" id="plant-nE"><rect x="270" y="120" width="150" height="50" rx="8" /><text class="t1" x="345" y="140" text-anchor="middle">GT2</text><text class="t2" x="345" y="158" text-anchor="middle">Gas turbine</text></g>
          <g class="n" id="plant-nF"><rect x="500" y="120" width="150" height="50" rx="8" /><text class="t1" x="575" y="140" text-anchor="middle">Meters</text><text class="t2" x="575" y="158" text-anchor="middle">Operating hours</text></g>
          <g class="n" id="plant-nG"><rect x="40" y="220" width="150" height="50" rx="8" /><text class="t1" x="115" y="240" text-anchor="middle">HRSG1</text><text class="t2" x="115" y="258" text-anchor="middle">Heat recovery boiler</text></g>
          <g class="n" id="plant-nH"><rect x="270" y="220" width="150" height="50" rx="8" /><text class="t1" x="345" y="240" text-anchor="middle">Steam turbine</text><text class="t2" x="345" y="258" text-anchor="middle">Shared</text></g>
          <g class="n" id="plant-nI"><rect x="170" y="320" width="150" height="50" rx="8" /><text class="t1" x="245" y="340" text-anchor="middle">Block ALDER-B1</text><text class="t2" x="245" y="358" text-anchor="middle">612 MW</text></g>
          <g class="n" id="plant-nJ"><rect x="500" y="320" width="150" height="50" rx="8" /><text class="t1" x="575" y="340" text-anchor="middle">Loan and contracts</text><text class="t2" x="575" y="358" text-anchor="middle">Debt service</text></g>
        </svg>
      </div>

      <div class="plant-panel" aria-live="polite">
        <p class="plant-q" id="plant-q"></p>
        <p class="plant-label">Path traversed</p>
        <div class="plant-chips" id="plant-path"></div>
        <p class="plant-label">Link types</p>
        <div class="plant-chips" id="plant-links"></div>
        <p class="plant-label">Answer</p>
        <p class="plant-answer" id="plant-answer"></p>
      </div>
    </div>

    <p class="plant-note">Fictitious data, for illustration only.</p>
  </div>
</section>
<script is:inline src="/plant-example.js" defer></script>
