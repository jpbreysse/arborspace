---
import Page from '../../layouts/Page.astro';

const team = [
  {
    name: 'Jean-Philippe Breysse',
    initials: 'JP',
    role: 'Founder · Designed the solution',
    bio: 'Twenty-two years at Oracle, from sales consulting to cloud architecture for the EMEA ISV team. Then cloud and database engineering at Avaloq, on the migration of 30 banks to the cloud, and DevSecOps for the Swiss Federal Office of Information Technology.',
    facts: ['30 years in enterprise IT', 'Oracle Cloud certified architect', 'MSc Computer Science, Paris Dauphine'],
  },
  {
    name: 'Philippe Mahieu',
    initials: 'PM',
    role: 'CEO',
    bio: 'Senior IT project and program manager focused on business transformation. Executive technology advisor on enterprise IT and data governance, with a 30-year career across Europe, the USA, Asia and India.',
    facts: ['30 years in enterprise IT', 'Oracle, 2001 to 2008', 'ESME engineering school'],
  },
];
---
<Page
  title="About"
  description="Why we are building ArborSpace: bringing the ontology layer to firms that sell expertise."
  eyebrow="Company · About"
  heading="Bringing the ontology layer to expert firms."
  lead="Turning raw tables into linked business objects is what makes the largest data platforms valuable. Today that layer is reserved for very large organisations. We are building ArborSpace so that firms that sell expertise can have it too."
>
  <section>
    <div class="wrap">
      <div class="prose">
        <h2>What we believe</h2>
        <ul>
          <li><strong>The value is in the ontology</strong>, not in the analysis.</li>
          <li><strong>Expert knowledge should be readable</strong>: every conclusion traces back to a named rule.</li>
          <li><strong>People decide</strong>: the system proposes findings, experts approve or reject them.</li>
          <li><strong>Your data stays with you</strong>: on your premises or in your own cloud.</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        <h2>Two IT veterans.</h2>
        <p class="lead">ArborSpace is built by a team of two, both former Oracle, based in Geneva.</p>
      </div>
      <div class="cards team">
        {team.map((m) => (
          <div class="card">
            <span class="avatar" aria-hidden="true">{m.initials}</span>
            <h3>{m.name}</h3>
            <p class="role">{m.role}</p>
            <p>{m.bio}</p>
            <ul class="facts">{m.facts.map((f) => <li>{f}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Page>
