---
import Page from '../../layouts/Page.astro';

const team = [
  { name: 'Jeanphi', role: 'Designed the solution' },
  { name: 'Philippe', role: 'CEO' },
];
---
<Page
  title="About"
  description="Why we are building ArborSpace: bringing the ontology layer to firms that sell expertise."
  eyebrow="Company · About"
  heading="Bringing the ontology layer to expert firms."
  lead="Turning raw tables into linked business objects is what makes the largest data platforms valuable. Today that layer is reserved for very large organisations. We are building ArborSpace so that firms that sell expertise can have it too."
>
  <section>
    <div class="wrap">
      <div class="prose">
        <h2>What we believe</h2>
        <ul>
          <li><strong>The value is in the ontology</strong>, not in the analysis.</li>
          <li><strong>Expert knowledge should be readable</strong>: every conclusion traces back to a named rule.</li>
          <li><strong>People decide</strong>: the system proposes findings, experts approve or reject them.</li>
          <li><strong>Your data stays with you</strong>: on your premises or in your own cloud.</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        <h2>Two IT veterans.</h2>
        <p class="lead">ArborSpace is built by a team of two.</p>
      </div>
      <div class="cards team">
        {team.map((m) => (
          <div class="card">
            <span class="avatar" aria-hidden="true">{m.name[0]}</span>
            <h3>{m.name}</h3>
            <p class="role">{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Page>
