---
import Base from '../layouts/Base.astro';
import ReviewWindow from '../components/ReviewWindow.astro';
import { contactEmail } from '../data/site';

const talkMailto = `mailto:${contactEmail}?subject=ArborSpace`;

// One gap in the Alder Creek maintenance plan, seen by four actors
const consequences = [
  {
    figure: '+3 days, +45 kUSD',
    actor: 'Due diligence firm',
    question: 'Is the seller’s maintenance plan credible?',
    text: 'Planned at 12 days and 420 kUSD. Last time: 15 days and 465 kUSD.',
  },
  {
    figure: '2.4% → 3%',
    actor: 'Bank',
    question: 'What does maintenance cost the output that repays the debt?',
    text: '306 MW offline during the outage. The share of annual output lost depends on whose number you believe.',
  },
  {
    figure: '22,000 MWh',
    actor: 'Trader',
    question: 'Which output have I sold that I will not be able to deliver?',
    text: 'The volume to buy back if the inspection runs 15 days instead of 12.',
  },
  {
    figure: '8% overdue',
    actor: 'Operator',
    question: 'Are my turbines on schedule?',
    text: 'Gas turbine 2 has run past its inspection interval. The plan schedules it for 2027.',
  },
];

const how = [
  { title: 'Your rules, written down.', text: 'Your analysts state what they check. The system applies it to every asset, every time.', icon: 'M8 4H5v16h3M16 4h3v16h-3M9 12h6' },
  { title: 'Every figure has a path.', text: 'From the number back to the turbine, the maintenance record and the rule that produced it.', icon: 'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 17l10-10' },
  { title: 'On your servers.', text: 'Deployed on your premises or in your own cloud, with code you can audit.', icon: 'M4 11l8-6 8 6v9H4zM10 20v-5h4v5' },
];
---
<Base
  title="ArborSpace: judge an asset you don't operate"
  description="ArborSpace applies your analysts' own rules to someone else's data and shows where each conclusion comes from. For lenders, investors, traders and their advisers."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Judge an asset you <em>don’t operate.</em></h1>
        <p class="hero-text">
          Lenders, investors, traders and their advisers decide on plants they have never run,
          from someone else’s data. ArborSpace applies your analysts’ own rules to that data and
          shows where each conclusion comes from.
        </p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={talkMailto}>Talk to me</a>
        </div>
      </div>
      <ReviewWindow />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Alder Creek</p>
        <h2>One gap in the maintenance plan. Four consequences.</h2>
        <p class="lead">
          At Alder Creek, the 2027 inspection is planned at 12 days. The same inspection in 2025
          took 15.
        </p>
      </div>
      <div class="cards impact">
        {consequences.map((c) => (
          <div class="card">
            <p class="figure">{c.figure}</p>
            <p class="who"><strong>{c.actor}:</strong> {c.question}</p>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
      <p class="fine">Illustrative data. Alder Creek is a fictional plant.</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it gets there</p>
        <h2>Your rules, applied to their data.</h2>
      </div>
      <div class="cards three">
        {how.map((h) => (
          <div class="card">
            <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={h.icon} /></svg></span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </div>
        ))}
      </div>
      <div class="actions">
        <a class="btn btn-outline btn-lg" href="/product">See how it works</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <p class="eyebrow">Who is behind this</p>
        <h2>A product at pilot stage.</h2>
      </div>
      <div class="prose">
        <p>
          I’m Jean-Philippe Breysse, an enterprise architect based in the Geneva area, with more
          than 30 years in IT, 19 of them at Oracle. ArborSpace is the product I’m building. It is
          at pilot stage, and I’m looking for the first teams to test it on their own assets.
        </p>
      </div>
    </div>
  </section>

  <section class="alt" id="contact">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2><a href={talkMailto}>{contactEmail}</a></h2>
      </div>
    </div>
  </section>
</Base>
